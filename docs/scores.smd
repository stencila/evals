```python exec always
# calculating the pareto frontier

import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

def calc_3d_pareto_frontier(points, maximize_x=True, maximize_y=True, maximize_z=True):
    points = np.array(points)
    signs = np.array([1 if maximize_x else -1, 
                      1 if maximize_y else -1, 
                      1 if maximize_z else -1])
    modified_points = points * signs
    
    is_efficient = np.ones(len(modified_points), dtype=bool)
    for i, point in enumerate(modified_points):
        if is_efficient[i]:
            is_efficient[is_efficient] = np.any(
                modified_points[is_efficient] > point, axis=1
            ) | np.all(modified_points[is_efficient] == point, axis=1)
    
    return points[is_efficient]

df = pd.read_parquet("../data/routing/scoring.parquet")


model_names = df["model"].unique()
model_names
