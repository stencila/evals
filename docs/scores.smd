Comparing the speed, quality and cost of large language models

```python exec auto
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from decimal import Decimal
from mpl_toolkits.mplot3d import Axes3D
import matplotlib.patheffects as path_effects

# Function to find Pareto frontier points
def find_pareto_frontier_3d(points, maximize_x=True, maximize_y=False, maximize_z=True):
    """Calculate the 3D Pareto frontier given a set of points and optimization directions

    For each dimension, True means higher values are better (maximize),
    False means lower values are better (minimize).
    """
    pareto_indices = []
    n = len(points)

    for i in range(n):
        dominated = False
        current = points[i]

        for j in range(n):
            if i == j:
                continue

            other = points[j]

            # For quality (x): higher is better if maximize_x is True
            x_better_or_equal = (other[0] >= current[0]) if maximize_x else (other[0] <= current[0])
            # For cost (y): lower is better if maximize_y is False
            y_better_or_equal = (other[1] >= current[1]) if maximize_y else (other[1] <= current[1])
            # For speed (z): higher is better if maximize_z is True
            z_better_or_equal = (other[2] >= current[2]) if maximize_z else (other[2] <= current[2])

            # Check if at least one dimension is strictly better
            x_strictly_better = (other[0] > current[0]) if maximize_x else (other[0] < current[0])
            y_strictly_better = (other[1] > current[1]) if maximize_y else (other[1] < current[1])
            z_strictly_better = (other[2] > current[2]) if maximize_z else (other[2] < current[2])

            if (x_better_or_equal and y_better_or_equal and z_better_or_equal and
                (x_strictly_better or y_strictly_better or z_strictly_better)):
                dominated = True
                break

        if not dominated:
            pareto_indices.append(i)

    return pareto_indices

# Read the CSV file
